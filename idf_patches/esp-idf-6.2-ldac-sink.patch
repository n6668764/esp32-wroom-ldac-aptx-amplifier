diff --git a/components/bt/host/bluedroid/btc/profile/std/include/btc_av_api.h b/components/bt/host/bluedroid/btc/profile/std/include/btc_av_api.h
--- a/components/bt/host/bluedroid/btc/profile/std/include/btc_av_api.h
+++ b/components/bt/host/bluedroid/btc/profile/std/include/btc_av_api.h
@@ -57,4 +57,13 @@ typedef UINT8 tBTC_AV_CODEC_ID;
 #define BTC_AV_APTX_RATE_44     0x20
 #define BTC_AV_APTX_CHAN_STEREO 0x02
 
+#define BTC_AV_LDAC_VENDOR_ID0  0x2D
+#define BTC_AV_LDAC_VENDOR_ID1  0x01
+#define BTC_AV_LDAC_CODEC_ID0   0xAA
+#define BTC_AV_LDAC_RATE_MASK   0x3F
+#define BTC_AV_LDAC_RATE_48     0x10
+#define BTC_AV_LDAC_RATE_44     0x20
+#define BTC_AV_LDAC_CHAN_MASK   0x07
+#define BTC_AV_LDAC_CHAN_STEREO 0x01
+
 static inline BOOLEAN btc_av_is_aptx_classic_codec_info(const UINT8 *info)
@@ -85,4 +94,13 @@ static inline BOOLEAN btc_av_is_aptx_codec_info(const UINT8 *info)
            (info[9] & BTC_AV_APTX_CHAN_MASK) != 0;
 }
 
+static inline BOOLEAN btc_av_is_ldac_codec_info(const UINT8 *info)
+{
+    return info != NULL && info[0] == 10 && info[2] == 0xff &&
+           info[3] == BTC_AV_LDAC_VENDOR_ID0 && info[4] == BTC_AV_LDAC_VENDOR_ID1 &&
+           info[5] == 0 && info[6] == 0 && info[7] == BTC_AV_LDAC_CODEC_ID0 && info[8] == 0 &&
+           (info[9] & BTC_AV_LDAC_RATE_MASK) != 0 &&
+           (info[10] & BTC_AV_LDAC_CHAN_MASK) != 0;
+}
+
 static inline BOOLEAN btc_av_aptx_cfg_in_cap(const UINT8 *cfg, const UINT8 *cap)
@@ -98,4 +116,22 @@ static inline BOOLEAN btc_av_aptx_cfg_in_cap(const UINT8 *cfg, const UINT8 *cap)
            (cfg[9] & BTC_AV_APTX_CHAN_MASK & cap[9]) != 0;
 }
 
+static inline BOOLEAN btc_av_is_vendor_codec_info(const UINT8 *info)
+{
+    return btc_av_is_aptx_codec_info(info) || btc_av_is_ldac_codec_info(info);
+}
+
+static inline BOOLEAN btc_av_vendor_cfg_in_cap(const UINT8 *cfg, const UINT8 *cap)
+{
+    if (btc_av_is_aptx_codec_info(cfg) && btc_av_is_aptx_codec_info(cap)) {
+        return btc_av_aptx_cfg_in_cap(cfg, cap);
+    }
+    if (btc_av_is_ldac_codec_info(cfg) && btc_av_is_ldac_codec_info(cap)) {
+        return cfg[3] == cap[3] && cfg[4] == cap[4] && cfg[7] == cap[7] &&
+               (cfg[9] & BTC_AV_LDAC_RATE_MASK & cap[9]) != 0 &&
+               (cfg[10] & BTC_AV_LDAC_CHAN_MASK & cap[10]) != 0;
+    }
+    return FALSE;
+}
+
 /* AV features masks */
